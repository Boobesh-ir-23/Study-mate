# ==============================================================================
# PERSONAL LMS - ENVIRONMENT SECRETS CONFIGURATION
# ==============================================================================
# IMPORTANT: Never commit actual passwords or keys to GitHub!
# Set these secrets in Cloudflare using the Wrangler CLI:
#
#   wrangler secret put ADMIN_PASSWORD
#   wrangler secret put WEB3FORMS_ACCESS_KEY
#
# For local development with `npm run dev`, you can create a `.dev.vars` file
# containing these variables.
# ==============================================================================

# Master Admin Password (Required for ?admin#/ and Ctrl+Shift+A access)
ADMIN_PASSWORD=your_super_secret_admin_password_here

# Web3Forms Access Key for Student Suggestions (Get your free key at https://web3forms.com)
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Target Email Address where Web3Forms sends student suggestions (optional, configured in Web3Forms)
# ADMIN_EMAIL=your_email@example.com
